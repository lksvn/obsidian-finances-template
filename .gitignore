# Obsidian settings and state are local to each installation.
vault/.obsidian/
vault/.trash/

# Generated financial data must never be published from a working copy.
vault/FINANCES/TRANSACTIONS/**
vault/FINANCES/PEOPLE/**
vault/FINANCES/PERIODS/**
!vault/FINANCES/TRANSACTIONS/.gitkeep
!vault/FINANCES/PEOPLE/.gitkeep
!vault/FINANCES/PERIODS/.gitkeep

# Environment files and local secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# Common tooling caches and dependencies
node_modules/
.cache/
.pytest_cache/
__pycache__/
*.py[cod]

# IDEs and editors
.idea/
.vscode/

# Operating systems
.DS_Store
._*
Thumbs.db
desktop.ini
$RECYCLE.BIN/
